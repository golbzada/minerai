{
  "manifest_version": 3,
  "name": "Mineraí",
  "version": "1.27.0",
  "description": "Garimpagem e inteligência de anúncios de alta performance direto da Biblioteca de Anúncios Meta.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Mineraí"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*",
        "https://web.facebook.com/ads/library/*",
        "https://facebook.com/ads/library/*",
        "https://ads.meta.com/ads/library/*"
      ],
      "js": [
        "rastreio-regras.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "https://mineraiofertas.vercel.app/*"
      ],
      "js": [
        "sessao-regras.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "offscreen",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://vqqzpkdxyaowqxdfshex.supabase.co/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
