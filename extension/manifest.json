{
  "manifest_version": 3,
  "name": "Mineraí Extensão",
  "version": "1.0.0",
  "description": "Garimpagem e inteligência de anúncios de alta performance direto da Biblioteca de Anúncios Meta.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Mineraí Extensão"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*",
        "https://web.facebook.com/ads/library/*",
        "https://facebook.com/ads/library/*",
        "https://ads.meta.com/ads/library/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "https://*.minerarads.com.br/*",
        "https://*.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://*.facebook.com/ads/library/*",
    "https://*.meta.com/ads/library/*",
    "http://localhost:*/*",
    "https://*.supabase.co/*",
    "https://*.vercel.app/*",
    "https://*.minerarads.com.br/*"
  ]
}
